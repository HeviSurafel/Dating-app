# ============================================
# DATING APP FLUTTER - ENVIRONMENT VARIABLES
# ============================================

# -------------------- API CONFIG --------------------
API_URL=http://localhost:5000/api
API_TIMEOUT=30000

# -------------------- ENVIRONMENT --------------------
ENV=development

# -------------------- APP CONFIG --------------------
APP_NAME=Dating App
APP_VERSION=1.0.0

# -------------------- AUTHENTICATION --------------------
JWT_SECRET=Datingapp@2026
JWT_EXPIRE=7d
REFRESH_TOKEN_SECRET=RefreshToken
REFRESH_TOKEN_EXPIRE=30d

# -------------------- FEATURE FLAGS --------------------
ENABLE_PUSH_NOTIFICATIONS=true
ENABLE_LOCATION_SERVICES=true
ENABLE_VIDEO_CALLS=false
ENABLE_VOICE_CALLS=false

# -------------------- LIMITS --------------------
MAX_PHOTOS=6
DEFAULT_SWIPE_LIMIT=50
OTP_EXPIRY_SECONDS=600
